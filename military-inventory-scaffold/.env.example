# Copia este archivo a .env y completa los valores.

# Clave secreta de Django (genera una para producción).
SECRET_KEY=dev-insecure-change-me

# Depuración: True en desarrollo, False en producción.
DEBUG=True

# Hosts permitidos (coma-separado). En Railway usa tu dominio.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF en producción (coma-separado, con https://).
CSRF_TRUSTED_ORIGINS=

# Base de datos. Si se deja vacío, usa SQLite local (db.sqlite3).
# En producción/Docker, Postgres, por ejemplo:
# DATABASE_URL=postgres://usuario:clave@host:5432/armory
DATABASE_URL=

# Nombre de la unidad sembrada.
DEFAULT_UNIDAD=Batallón de Selva No. 52

# Lista blanca de correos autorizados a ingresar (coma-separado, en minúsculas).
AUTHORIZED_EMAILS=davidbg91@gmail.com,jhon1991losada@gmail.com,pololuis500@gmail.com
